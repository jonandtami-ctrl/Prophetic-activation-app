# Cloud sync (optional). Without these set, Prophetic Journal runs fully
# offline on-device — nothing is lost, it just won't sync across devices.
# Create a free project at https://supabase.com, run supabase/schema.sql
# against it, then copy its URL + anon key here as EXPO_PUBLIC_* vars so
# Expo can read them at build time.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
